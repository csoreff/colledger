# --- Database ---
# DATABASE_URL is what the app queries through. On a serverless host (Vercel)
# point it at the POOLED connection string — one Postgres connection per
# lambda invocation will exhaust the server otherwise.
DATABASE_URL="postgresql://USER@localhost:5432/collectors_ledger?schema=public"

# DIRECT_URL is used only by `prisma migrate`. Poolers like PgBouncer can't run
# DDL, so migrations need an unpooled connection. Locally the two are the same.
DIRECT_URL="postgresql://USER@localhost:5432/collectors_ledger?schema=public"

# --- Auth ---
# Signs the session JWT. Generate with: openssl rand -base64 32
# Changing it signs everyone out. Never commit the real value.
NEXTAUTH_SECRET=""

# The app's own URL. Vercel sets this automatically on preview and production
# deployments; set it explicitly for any other host.
NEXTAUTH_URL="http://localhost:3000"

# Public registration. The first account to register becomes an ADMIN; set
# this to "false" afterwards to stop anyone else signing up.
ALLOW_SIGNUP="true"

# --- eBay sold-comp providers ---
# Which provider to use: "ebay-api" | "manual"
#   ebay-api -> eBay Marketplace Insights; reports true accepted Best Offer prices
#   manual   -> no network calls; you enter every comp yourself
COMP_PROVIDER="ebay-api"

# eBay official API (Marketplace Insights) — only used when COMP_PROVIDER=ebay-api.
# Marketplace Insights returns TRUE accepted Best Offer prices but requires
# eBay business approval. Leave blank until you have it.
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
EBAY_MARKETPLACE_ID="EBAY_US"

# How long a comp search stays cached before re-fetching (minutes).
COMP_CACHE_MINUTES="720"

# --- Seed script only ---
# Which account `npm run seed` creates its sample data under.
SEED_EMAIL="demo@collectors-ledger.local"
SEED_PASSWORD=""
