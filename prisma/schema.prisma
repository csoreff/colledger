// Collectors Ledger — trading card & manga purchase/sale/expense tracking
//
// MONEY: every amount is stored twice, once per currency, as an integer in that
// currency's minor unit — USD in cents, JPY in whole yen (yen has no subunit).
// Integers avoid float drift and Prisma Decimal serialization headaches.
//
// Each record that carries money also records the currency it was actually
// transacted in plus the FX rate used, so the converted figure is reproducible
// and stays fixed at its historical value no matter how rates move later.
// See `src/lib/currency.ts` and `src/lib/fx.ts`.
//
// TENANCY: every ledger row carries `userId` directly rather than reaching it
// through a parent relation. The denormalization is deliberate — it means a
// tenant filter is always one column away, so an update or delete can be
// written as `where: { id, userId }` and cannot touch another user's row even
// if an id is guessed. Rows inherit their owner from their parent on create;
// `src/lib/tenant.ts` is the only place that decides what that owner is.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Pooled connections (PgBouncer on Neon/Supabase) can't run DDL, so
  // migrations go through the direct connection. Falls back to DATABASE_URL
  // locally, where the two are the same.
  directUrl = env("DIRECT_URL")
}

enum ItemType {
  CARD
  MANGA
}

enum ItemStatus {
  OWNED
  LISTED
  SOLD
  RETURNED
  LOST
}

/// Grading company. RAW means ungraded.
enum Grader {
  RAW
  PSA
  BGS
  CGC
  SGC
  TAG
  ACE
  ARS
  OTHER
}

enum ExpenseCategory {
  SHIPPING_IN
  SHIPPING_OUT
  GRADING
  SUPPLIES
  PLATFORM_FEE
  TAX
  TRAVEL
  SUBSCRIPTION
  STORAGE
  AUTHENTICATION
  OTHER
}

enum Marketplace {
  EBAY
  SNKRDUNK
  PAYPAY_FLEA
  YAHOO_AUCTIONS
  MERCARI
  TCGPLAYER
  WHATNOT
  AMAZON
  FACEBOOK
  LOCAL
  SHOW
  OTHER
}

/// Currencies a transaction can settle in.
///
/// USD and JPY are the *reporting* pair: every amount is stored in both, and
/// all totals, sorting and profit are computed in both. GBP and AUD are
/// *transaction* currencies — an amount paid in them is recorded natively and
/// converted into the reporting pair at that date's rate.
enum Currency {
  USD
  JPY
  GBP
  AUD
}

enum UserRole {
  USER
  ADMIN
}

/// What an API key is allowed to do. A key can never exceed its owner's role:
/// ADMIN_ALL on a key owned by a plain user is meaningless and is rejected when
/// the key is minted.
enum ApiScope {
  /// Read the ledger.
  READ
  /// Create, update and delete ledger rows.
  WRITE
  /// Act on any user's ledger by naming them, and manage users.
  ADMIN_ALL
}

/// A person with a login. Each user owns an entirely separate ledger.
model User {
  id String @id @default(cuid())

  email String @unique
  name  String?
  /// bcrypt. Empty string means "no password set" — the account exists but
  /// cannot be signed into until one is set (the adopted legacy account).
  passwordHash String
  role         UserRole @default(USER)

  /// Set false to keep an account on file but block sign-in and API use.
  isActive Boolean @default(true)

  /// Opt-in public collection page at /showcase/<publicSlug>.
  ///
  /// Defaults to false, and every existing account is backfilled to false, so
  /// enabling a showcase is always a deliberate act. It is the only way any
  /// data in this database becomes readable without authentication; what that
  /// page may show is fixed by an allowlist in `src/lib/showcase.ts`.
  publicShowcase Boolean @default(false)
  /// The name in the public URL. Unique across accounts, and deliberately not
  /// derived from the email — the page should not hand out an address.
  publicSlug String? @unique

  items        Item[]
  purchases    Purchase[]
  expenses     Expense[]
  sales        Sale[]
  compSearches CompSearch[]
  apiKeys      ApiKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

/// A bearer token for the REST API.
///
/// Only the SHA-256 of the key is stored, so a database leak does not hand over
/// working credentials and the plaintext can be shown exactly once at creation.
/// `prefix` is the first few visible characters, kept purely so a key is
/// recognizable in the management UI.
model ApiKey {
  id String @id @default(cuid())

  /// The key's owner. Requests act as this user unless the key carries
  /// ADMIN_ALL and names a different one.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name   String
  prefix String
  /// SHA-256 hex of the full plaintext key. Unique so a lookup is one indexed
  /// read rather than a scan-and-compare.
  hash   String @unique

  scopes ApiScope[]

  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

/// Cached daily USD->JPY rate, so a given transaction date is fetched once.
/// Not tenanted: a published exchange rate is the same fact for everyone, and
/// sharing the cache means one user's lookup warms it for the rest.
model FxRate {
  id String @id @default(cuid())

  /// The date that was asked for (may be a weekend or holiday).
  requestedDate DateTime @unique
  /// The date the rate actually comes from. Markets are shut at weekends, so
  /// this rolls back to the previous business day.
  effectiveDate DateTime
  /// Yen per one US dollar, e.g. 157.45.
  jpyPerUsd     Float
  /// Pounds / Australian dollars per one US dollar. Null on rows cached before
  /// those currencies were supported; fetched on demand and filled in.
  gbpPerUsd     Float?
  audPerUsd     Float?
  /// True when no rate existed for the requested date and the latest available
  /// one was substituted (a future date, or before the ECB series begins).
  isFallback    Boolean @default(false)
  source        String  @default("frankfurter")

  fetchedAt DateTime @default(now())

  @@index([effectiveDate])
}

model Item {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Caller-supplied id from whatever system pushed this row in over the API.
  /// Unique per user, so a remote seed can be re-run and will update rather
  /// than duplicate. Null for rows created through the web UI.
  externalRef String?

  // --- Identity: what the card or volume *is* ---
  type  ItemType
  title String

  /// Card set name, or manga series name.
  setName String?
  /// Card number, or manga volume number.
  number  String?
  /// Printing / variant / edition (e.g. "1st Edition", "Reverse Holo", "Omnibus").
  variant String?
  /// e.g. "English", "Japanese".
  language String @default("English")

  imageUrl String?
  notes    String?

  /// Saved search string used when pulling eBay sold comps for this item.
  compQuery String?

  /// Every copy you've acquired. Grading, price and status live per copy,
  /// because the same card bought twice can be a PSA 10 and a raw NM.
  purchases Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, externalRef])
  @@index([userId])
  @@index([type])
  @@index([title])
}

/// One acquisition of one item — a row in the purchases table. Owns its own
/// money, condition, status, expenses and sale, so several copies of the same
/// card bought on different dates at different prices stay independent.
model Purchase {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// Caller-supplied id for API upserts. See Item.externalRef.
  externalRef String?

  // --- Condition of this particular copy ---
  grader     Grader  @default(RAW)
  /// Numeric or letter grade as printed on the slab, e.g. "10", "9.5", "10+".
  grade      String?
  certNumber String?
  /// Raw condition when ungraded, e.g. "NM", "LP", "Like New".
  condition  String?

  /// How many identical copies this one purchase covered. The price below is
  /// the total for the row, not a per-unit figure.
  quantity Int @default(1)

  // --- Acquisition ---
  acquiredAt     DateTime
  purchaseSource Marketplace @default(OTHER)

  purchaseUsdCents Int
  purchaseJpyYen   Int
  /// The currency actually paid in. USD/JPY are stored above; GBP/AUD have no
  /// reporting column of their own and live in purchaseNativeMinor.
  purchaseCurrency Currency @default(USD)
  /// The amount in the currency actually paid, in that currency's minor unit
  /// (cents, pence, or whole yen). For USD and JPY this mirrors the column
  /// above; for GBP and AUD it is the only authoritative figure, the reporting
  /// pair being derived from it.
  purchaseNativeMinor Int?
  /// Units of the native currency per 1 USD on the transaction date.
  purchaseFxNativePerUsd Float?
  purchaseFxJpyPerUsd Float?
  purchaseFxDate      DateTime?

  purchaseNotes String?

  status ItemStatus @default(OWNED)
  notes  String?

  expenses Expense[]
  sales    Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, externalRef])
  @@index([userId])
  @@index([itemId])
  @@index([status])
  @@index([acquiredAt])
  @@index([grader])
  @@index([purchaseSource])
}

/// An expense. When `purchaseId` is null it is a GENERAL expense — overhead
/// that is not attributable to any single copy (supplies, subscriptions,
/// travel). One purchase may have many expenses.
model Expense {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  /// Caller-supplied id for API upserts. See Item.externalRef.
  externalRef String?

  category    ExpenseCategory
  description String
  incurredAt  DateTime

  amountUsdCents Int
  amountJpyYen   Int
  currency       Currency @default(USD)
  fxJpyPerUsd    Float?
  fxDate         DateTime?

  vendor String?
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, externalRef])
  @@index([userId])
  @@index([purchaseId])
  @@index([category])
  @@index([incurredAt])
}

/// A sale of one purchased copy. A row may sell across more than one
/// transaction when its quantity is greater than 1.
model Sale {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  /// Caller-supplied id for API upserts. See Item.externalRef.
  externalRef String?

  soldAt   DateTime
  platform Marketplace @default(EBAY)
  quantity Int         @default(1)

  /// The currency the sale settled in; the paired figures are derived from it.
  currency    Currency @default(USD)
  fxJpyPerUsd Float?
  fxDate      DateTime?

  /// What the buyer paid for the item itself (the true accepted price if this
  /// was a Best Offer — not the original asking price).
  grossPriceUsdCents Int
  grossPriceJpyYen   Int
  /// Shipping charged to the buyer (revenue).
  shippingCollectedUsdCents Int @default(0)
  shippingCollectedJpyYen   Int @default(0)
  /// Marketplace + payment processing fees.
  platformFeeUsdCents Int @default(0)
  platformFeeJpyYen   Int @default(0)
  /// Postage/packaging actually paid (cost).
  shippingCostUsdCents Int @default(0)
  shippingCostJpyYen   Int @default(0)
  otherFeeUsdCents     Int @default(0)
  otherFeeJpyYen       Int @default(0)

  /// True when the sale closed via an accepted Best Offer.
  wasBestOffer Boolean @default(false)
  /// Original asking price, kept for reference when wasBestOffer is true.
  listedPriceUsdCents Int?
  listedPriceJpyYen   Int?

  buyer String?
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, externalRef])
  @@index([userId])
  @@index([purchaseId])
  @@index([soldAt])
}

// ---------------------------------------------------------------------------
// eBay sold-comp lookup
// ---------------------------------------------------------------------------

/// A cached comp search. Results are stored so repeat lookups don't re-hit the
/// upstream provider, and so manually-corrected prices survive.
///
/// Tenanted despite comps being public market data, because the hand-entered
/// comps and hand-corrected Best Offer prices attached to a search are the
/// user's own research and must not leak between accounts.
model CompSearch {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Normalized cache key: query + filters. Unique per user, not globally.
  cacheKey String

  query     String
  itemType  ItemType?
  /// null = any, RAW = ungraded only, otherwise that grading company only.
  grader    Grader?
  grade     String?

  provider      String
  fetchedAt     DateTime @default(now())
  resultCount   Int      @default(0)
  /// Provider-reported problem, surfaced in the UI rather than thrown away.
  warning       String?

  comps SoldComp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, cacheKey])
  @@index([userId])
  @@index([query])
}

/// A single sold listing pulled from a comp provider.
model SoldComp {
  id String @id @default(cuid())

  searchId String
  search   CompSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)

  /// Provider's id for the listing, used to dedupe within a search.
  externalId String?
  title      String
  url        String?
  imageUrl   String?
  soldAt     DateTime?

  /// The price we believe the buyer actually paid.
  salePriceUsdCents Int
  salePriceJpyYen   Int
  /// The original asking price when different from the sale price.
  listedPriceUsdCents Int?
  listedPriceJpyYen   Int?
  shippingUsdCents    Int?
  shippingJpyYen      Int?

  /// The currency the listing was denominated in.
  currency    Currency @default(USD)
  fxJpyPerUsd Float?
  fxDate      DateTime?

  /// The listing closed via an accepted Best Offer.
  wasBestOffer Boolean @default(false)
  /// TRUE when salePriceCents is the real accepted offer amount.
  /// FALSE on a Best Offer listing whose true price the provider could not
  /// resolve — salePriceCents is then only the asking price (an upper bound).
  priceIsConfirmed Boolean @default(true)

  /// A price the user typed in to correct/fill an unresolved Best Offer.
  /// Takes precedence over the provider's price everywhere in the UI.
  manualPriceUsdCents Int?
  manualPriceJpyYen   Int?

  grader    Grader?
  grade     String?
  condition String?

  provider String

  createdAt DateTime @default(now())

  @@index([searchId])
  @@index([soldAt])
}
